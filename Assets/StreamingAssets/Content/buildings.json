{
  // Sizes match Docs/ART_GUIDE.md.
  // Power is in watts. 1 tile = 64 px = 256 sub-units; subPerTick 32 = one tile every 8 ticks (~3.75 tiles/s).
  // "cost" is taken straight out of your inventory when you place the building — there is no
  // separate "building item" to craft first. The first smelter costs only hand-mined stone, which
  // is what gets the whole chain started.
  "buildings": [
    { "id": "crashpod", "name": "Crashed time pod", "width": 3, "height": 3, "kind": "Generator", "rotatable": false, "maxHealth": 2000,
      "powerOutput": 200000, "decayTicks": 216000, "decayFloorPermille": 100, "warmthRadiusTiles": 4, "warmthPerTick": 6 },
    { "id": "drill", "name": "Miner MK1", "width": 3, "height": 3, "kind": "Drill", "maxHealth": 300,
      "powerUse": 30000, "mineTicksPerItem": 60, "outputSlots": 1,
      "animationMode": "loop", "animationFps": 10,
      "cost": { "iron_plate": 8, "stone": 4 } },
    { "id": "smelter", "name": "Smelter", "width": 2, "height": 2, "kind": "Crafter", "crafterType": "smelter", "maxHealth": 250,
      "powerUse": 40000, "inputSlots": 1, "outputSlots": 1, "warmthRadiusTiles": 3, "warmthPerTick": 3,
      "animationMode": "progress",   // 10 frames stretched across the craft, so it ends as the item appears
      "cost": { "stone": 12 } },
    { "id": "assembler", "name": "Assembler", "width": 3, "height": 3, "kind": "Crafter", "crafterType": "assembler", "maxHealth": 300,
      "powerUse": 50000, "inputSlots": 4, "outputSlots": 2,
      "cost": { "iron_plate": 12, "copper_plate": 6 } },
    { "id": "encoder", "name": "Data cell encoder", "width": 2, "height": 2, "kind": "Crafter", "crafterType": "encoder", "maxHealth": 200,
      "powerUse": 60000, "inputSlots": 3, "outputSlots": 1,
      "cost": { "iron_plate": 10, "copper_plate": 10 } },
    { "id": "datacenter_l1", "name": "Data center L1", "width": 4, "height": 4, "kind": "DataCenter", "maxHealth": 600,
      "powerUse": 150000, "researchPerTick": 1, "heatPerTick": 2, "maxHeat": 1000, "inputSlots": 4,
      "cost": { "iron_plate": 30, "copper_plate": 20, "circuit": 5 } },
    { "id": "chest", "name": "Chest", "width": 1, "height": 1, "kind": "Chest", "rotatable": false, "maxHealth": 100, "slots": 16,
      "cost": { "iron_plate": 4 } },
    { "id": "tube", "name": "Tube", "width": 1, "height": 1, "kind": "Tube", "maxHealth": 50, "powerUse": 500, "subPerTick": 32, "itemsPerTile": 4,
      "cost": { "iron_plate": 1 } },
    { "id": "wire", "name": "Data wire (iron)", "width": 1, "height": 1, "kind": "Wire", "maxHealth": 50, "subPerTick": 32, "itemsPerTile": 4,
      "cost": { "copper_plate": 1 } },
    // Occupies one tile; moves items between any two of its four neighbours (player picks input/output).
    { "id": "arm", "name": "Arm", "width": 1, "height": 1, "kind": "Arm", "maxHealth": 80, "powerUse": 5000, "armTicksPerSwing": 10,
      "cost": { "iron_plate": 2, "copper_plate": 1 } },

    // Splits and merges belt lines on a single tile: anything can push items in from any side,
    // and it sends them out to whichever neighbours will take them, taking turns.
    { "id": "router", "name": "Router", "width": 1, "height": 1, "kind": "Router", "rotatable": false, "maxHealth": 60,
      "powerUse": 1000, "routerSlots": 4, "routerTicksPerItem": 6,
      "cost": { "iron_plate": 2 } },

    // --- power beyond the dying pod ---
    // Burns coal. Full output while something is alight, nothing at all when the fuel runs out.
    { "id": "coal_burner", "name": "Coal burner", "width": 2, "height": 2, "kind": "FuelGenerator", "maxHealth": 300,
      "powerOutput": 180000, "fuelSlots": 2, "warmthRadiusTiles": 4, "warmthPerTick": 5,
      "animationMode": "loop", "animationFps": 8,
      "cost": { "iron_plate": 10, "stone": 10 } },
    // Free power, but weak, and it has to be built in quantity. No fuel, no upkeep.
    { "id": "wind_turbine", "name": "Wind turbine", "width": 2, "height": 2, "kind": "Generator", "rotatable": false, "maxHealth": 150,
      "powerOutput": 30000,
      "animationMode": "loop", "animationFps": 12,
      "cost": { "iron_plate": 12, "copper_plate": 4 } },
    // Soaks up surplus power and gives it back during a shortfall.
    // energyCapacity is in watt-ticks: 30 watt-ticks = 1 joule, so this holds 5 MJ.
    { "id": "battery", "name": "Battery bank", "width": 1, "height": 1, "kind": "Battery", "rotatable": false, "maxHealth": 120,
      "energyCapacity": 150000000, "maxThroughput": 60000,
      "cost": { "iron_plate": 6, "copper_plate": 8 } }
  ]
}
